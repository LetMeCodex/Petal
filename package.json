{
  "name": "petal",
  "version": "1.0.0",
  "description": "Drag. Tap. Bloom. Drop a file on a petal to convert, compress, crop, clean or remove its background.",
  "main": "src/main.js",
  "scripts": {
    "test": "electron scripts/selftest.js",
    "start": "electron .",
    "snap": "electron scripts/snapshot.js .snap",
    "build:hook": "node -e \"require('./src/hook').ensureBuilt()\"",
    "test:editors": "electron scripts/editor-test.js",
    "test:tier2": "electron scripts/tier2-test.js",
    "test:island": "electron scripts/island-test.js",
    "test:fullscreen": "electron scripts/fullscreen-test.js",
    "test:perf": "electron scripts/perf-test.js",
    "test:hook": "node scripts/hook-cost-test.js",
    "test:drag": "electron scripts/island-drag-test.js",
    "test:ask": "node scripts/ask-parse-test.js && node scripts/doubletap-test.js && electron scripts/ask-engine-test.js && electron scripts/ask-ui-test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^38.8.6"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "onnxruntime-node": "^1.30.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "sharp": "^0.35.5",
    "three": "^0.170.0"
  },
  "allowScripts": {
    "onnxruntime-node": false,
    "electron@38.8.6": true
  },
  "productName": "Petal"
}
